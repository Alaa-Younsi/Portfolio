{
  "name": "alaa-younsi-portfolio",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Interstellar framed portfolio of Alaa Younsi — hand-coded canvas physics, no UI libraries.",
  "author": "Alaa Younsi",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --build --force",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.23",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
